---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

import LegalTermsEn from '../components/ui/legal/LegalTermsEn.astro'
---

<Layout title="Aviso de Cookies | Arcadia Studio">
    <LegalTermsEn title="Aviso de Cookies" >
        <div class="w-full Ibmlight text-[3vw] md:text-[2.5vw] lg:text-[1vw] 2xl:text-[.9vw] flex flex-col">
            <p class="mb-[.5rem] self-end">Última actualización: 28 de diciembre 2025</p>
            <p>Este sitio web utiliza cookies para mejorar la experiencia del usuario.</p>
            <div class="w-[90%] self-end">
                <p class="IbmBold my-[.5rem]">¿Qué son las cookies?</p>
                <ul class="pl-[2rem] list-disc">
                    <li>Las cookies son pequeños archivos que se almacenan en tu dispositivo para recordar información sobre tu visita.</li>
                </ul>
                <p class="IbmBold my-[.5rem]">¿Qué tipo de cookies usamos?</p>
                <ul class="pl-[2rem] list-disc">
                    <li>Cookies técnicas necesarias para el funcionamiento del sitio</li>
                    <li>Cookies de análisis para entender cómo se utiliza el sitio (de forma anónima)</li>
                </ul>
                <p class="IbmBold my-[.5rem]">Gestión de cookies</p>
                <ul class="pl-[2rem] list-disc">
                    <li>Puedes aceptar, rechazar o eliminar las cookies desde la configuración de tu navegador. El uso continuado del sitio implica la aceptación del uso de cookies.</li>
                </ul>
            </div>
        </div>
    </LegalTermsEn>
</Layout>
