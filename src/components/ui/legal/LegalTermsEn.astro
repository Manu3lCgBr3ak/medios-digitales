---
export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---
<div class="w-full flex
    flex-col lg:flex-row
">
    <div class="Arcadia_background flex flex-col pr-[1rem]
        w-[100%] lg:w-[50%]
    ">
        <div class="first:self-end w-[60%] text-right py-[1rem]">
            <p class="IbmBold leading-none text-[#000000] drop-shadow-2xl/40
                text-[7vw] md:text-[6.5vw] lg:text-[5vw] xl:text-[4vw] 2xl:text-[4vw]
            ">{title}</p>
        </div>
        <div class="w-full flex justify-between items-end"></div>
    </div>
    <div class="p-[2rem] Ibmlight bg-[#E9E8E8]
        w-[100%] lg:w-[50%]
        text-[3vw] md:text-[2.2vw] lg:text-[1.8vw] xl:text-[1.2vw] 2xl:text-[1vw] 
    ">
        <slot />
    </div>
</div>