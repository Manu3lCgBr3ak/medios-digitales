---
import { Image } from "astro:assets";
import Arcadia_Logo from "../../assets/images/Arcadia_Logo.svg";
import Arcadia_ico from "../../assets/icons/Arcadia_ico.svg";

import CardExamples from "../ui/design_system/CardExamples.astro";

console.log(import.meta.env.MAIL_USER);
---
<div class="w-full h-auto flex flex-col lg:flex-row items-stretch gap-[2rem] p-[1rem] md:p-[4rem] bg-[#E9E8E8] py-[2rem]">
  {/* Div Ejemplos Y Boton CTA */}
  <div class="w-[90%] lg:w-1/3 self-center lg:self-stretch flex">
    {/* DIv Ejemplo */}
    <div class="w-full bg-[#000000] text-[#E9E8E8] grayscale flex flex-col justify-center items-center overflow-hidden relative
      rounded-3xl mb-[2rem] lg:mb-[5rem]
      p-[1rem] md:p-[2rem] lg:p-[1rem] xl:p-[2rem]
    ">
      <div class="w-full leading-none Ibmlight text-[2.8vw] md:text-[3vw] lg:text-[1vw] xl:text-[0.9vw] 2xl:text-[1vw] mb-[1rem] flex flex-col justify-center">
        <p>
          <span>Dejate</span> 
          <span class="IbmBold">Impresionar</span>
        </p>
        <p>
          <span>Por nuestro</span>
          <span class="IbmBold-italic">poder</span>
        </p>
      </div>
      
      <Image src={Arcadia_Logo} alt="Arcadia_Logo" class="w-[80%] self-end" loading="lazy"/>
    </div>
    {/* Boton CTA */}
    <div id="Cotizacion" class="w-full Arcadia_background rounded-3xl rounded-tr-0 flex flex-col justify-center items-center p-[2rem] md:p-[3rem] lg:p-[1.4rem] relative lg:mt-[5rem]">
      <p class="text-[4.5vw] md:text-[4.4vw] lg:text-[1.8vw] xl:text-[2vw] mb-[1rem] IbmBold leading-none">Recibe tu presupuesto personalizado por WhatsApp.</p>
      <a
        href="https://wa.me/message/FQDZ6T6NQTXGE1"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-[1rem] bg-[#e9e8e8] text-[#000000] rounded-full IbmBold shadow-[0_0_40px_rgba(255,255,255,0.2)] mb-[.5rem]
               transition-all duration-300 ease-out hover:scale-105 shadow-xl text-center
               text-[2.5vw] md:text-[2.2vw] lg:text-[1vw] xl:text-[1.2vw] 2xl:text-[.8vw] IbmBold"
        >
        ¡Quiero mi web! →
      </a>
      <p class="text-[1.8vw] md:text-[2.2vw] lg:text-[1vw] xl:text-[1vw] IbmLight-italic leading-none text-[#E9E8E8] text-center mb-[15%]">Sin compromiso. Sin complicaciones.</p>
      <Image
        src={Arcadia_ico}
        alt="Logo de Arcadia"
        class="w-[20%] md:w-[15%] lg:w-[30%] h-auto absolute bottom-[5%]"
        loading="lazy"
      />
    </div>
  </div>

  {/* Seunda Parte */}
  <div class="w-[90%] lg:w-1/3 self-center lg:self-stretch flex flex-col">
    <p class="text-[4vw] md:text-[3vw] lg:text-[1.8vw] xl:text-[1.8vw] flex flex-col IbmBold leading-none mb-[1rem] text-[#000000] ml-[1rem] md:ml-0">
      <span class="Ibmlight">Hablemos de</span>
      <span class="IbmBold">negocios</span>
    </p>
    <div class="w-full text-center flex justify-center">
      <p class="IbmBold leading-none text-[7vw] md:text-[7vw] lg:text-[2vw] xl:text-[2vw]">
        Tu
        <span class="text-[#FFAB50] text-[9vw] md:text-[8vw] lg:text-[3vw] xl:text-[4vw]">Web,</span>
        tu&nbsp;ritmo, tu&nbsp;presupuesto
      </p>
    </div>
    <div class="w-full flex justify-center text-center lg:text-start" id="Ejemplos">
      <p class="w-[80%] lg:w-full text-[3vw] md:text-[2.2vw] lg:text-[1vw] xl:text-[1vw] Ibmlight my-[1rem] text-end">
        No hay planes fijos. Cada web se diseña según lo que <span class="IbmBold">tú necesitas.</span>
      </p>
    </div>
    <div class="w-full bg-[#FFAB50] pr-0 flex-1 rounded-3xl flex flex-col gap-[.5rem] pt-[2rem]">
      <div id="carousel-2" class="relative w-full aspect-9/12 md:aspect-10/9 lg:aspect-9/9 px-4 overflow-hidden">
        <div id="carousel-track-2" class="flex transition-transform duration-300 ease-out h-full gap-[1rem]">
          {/* <div class="w-[90%] md:w-[58%] lg:w-[65%] flex-shrink-0 flex items-center justify-center rounded-3xl mx-auto overflow-hidden">
            <CardExamples title="Tienda en Linea" text="Vende tus productos 24/7 de forma simple y segura." img=""/>
          </div> */}
          <div class="w-[90%] md:w-[58%] lg:w-[65%] flex-shrink-0 flex items-center justify-center rounded-3xl mx-auto overflow-hidden">
            <CardExamples img={1} subrayado={false} title="Página de servicios" text="Expón tus servicios y convierte visitas en clientes." link="/ejemplos/pagina-de-servicios-ejemplo"/>
          </div>
          <div class="w-[90%] md:w-[58%] lg:w-[65%] flex-shrink-0 flex items-center justify-center rounded-3xl mx-auto overflow-hidden relative">
            <div class="w-full h-full absolute bg-black/20 z-10 backdrop-blur-[2px] flex justify-center items-center pt-[1rem]">
              <p class="bg-[#000000] IbmBold text-[#E9E8E8] px-[1rem] rounded-full shadow-lg/25">Próximamente</p>
            </div>
            <CardExamples img={0} subrayado={true} title="Pagina corporativa" text="Da confianza y presencia profesional a tu empresa." link=""/>
          </div>
          <div class="w-[90%] md:w-[58%] lg:w-[65%] flex-shrink-0 flex items-center justify-center rounded-3xl mx-auto overflow-hidden relative">
            <div class="w-full h-full absolute bg-black/20 z-10 backdrop-blur-[2px] flex justify-center items-center pt-[1rem]">
              <p class="bg-[#000000] IbmBold text-[#E9E8E8] px-[1rem] rounded-full shadow-lg/25">Próximamente</p>
            </div>
            <CardExamples img={0} subrayado={true} title="Portafolios personales" text="Muestra tu talento y consigue más oportunidades." link=""/>
          </div>
        </div>
      </div>
      <div class="w-full flex justify-end pr-[1rem] pb-[1rem] gap-[.5rem]">
        <button class="w-[10%] aspect-1/1 rounded-full bg-[#E9E8E8] text-[#000000] transition-all duration-300 ease-out hover:scale-105"><p>&lt;</p></button>
        <button class="w-[10%] aspect-1/1 rounded-full bg-[#E9E8E8] text-[#000000] transition-all duration-300 ease-out hover:scale-105"><p>&gt;</p></button>
      </div>

    </div>
  </div>

  <div class="w-[90%] lg:w-1/3 self-center lg:self-stretch flex flex-col gap-[1rem]">
    <div class="w-full h-[80%] bg-[#000000] rounded-[2rem] relative flex">
      <div class="w-full h-full flex flex-col justify-between items-center z-10 p-[2rem]">
        <div class="w-full text-white self-start">
          <p class="w-[60%] IbmBold leading-none text-[7.5vw] md:text-[8.5vw] lg:text-[2.1vw] xl:text-[2.5vw] 2xl:text-[2.5vw] mb-[1rem]">¿Todavía dudas?</p>
          <p class="w-[80%] Ibmlight leading-none text-[3vw] md:text-[2.5vw] lg:text-[1vw] 2xl:text-[1vw]">Déjanos tu correo y te contactaremos con una <span class="IbmBold">oferta exclusiva para ti.</span></p>
        </div>

        <div class="text-white w-full mt-[15rem] md:mt-[20rem] lg:mt-0">
          <p class="Ibmlight text-[4vw] md:text-[4vw] lg:text-[1.2vw] xl:text-[1.4vw] 2xl:text-[1.4vw] leading-none mb-[.5rem]">
            <span class="IbmLight">Ten acceso </span>
            <span class="IbmBold-italic">anticipado</span>
            <span>a nuevas</span>
            <span class="IbmRegular text-[#FFAB50]">promociones</span>
          </p>

          <form
            method="POST"
            action="/api/contact"
            class="flex gap-[.5rem] items-center mb-[2rem]"
            novalidate
          >
            <div class="relative w-[70%] flex justify-center items-center">
              <input
                type="email"
                name="email"
                required
                placeholder="Correo electrónico"
                class="
                  peer w-full bg-white rounded-full px-[1rem] py-[.5rem] text-black Ibmlight 
                  text-[3vw] md:text-[2.5vw] lg:text-[1vw] 2xl:text-[1vw] text-[#000000]
                  focus:rounded-2xl

                  outline-none transition-all duration-300

                  peer-[&:not(:placeholder-shown):invalid]:ring-4
                  peer-[&:not(:placeholder-shown):invalid]:ring-red-400/20
                "
              />

              <!-- TEXTO ERROR -->
              <span
                class="
                  pointer-events-none absolute left-[1rem] -bottom-[1.2rem]
                  text-[0.7rem] text-red-500
                  opacity-0 transition-opacity duration-300

                  peer-[&:not(:placeholder-shown):invalid]:opacity-100
                "
              >
                Correo no válido
              </span>
            </div>

            <button
              type="submit"
              class="w-[15%] md:w-[10%] lg:w-[10%] aspect-1/1 bg-[#FFAB50] rounded-full"
            >
              &gt;
            </button>
          </form>



          <p class="text-[3vw] md:text-[2.5vw] lg:text-[1vw] 2xl:text-[.9vw] Ibmlight leading-none">
            <span class="text-blue-300">¡No esperes más!</span>
            Da el primer paso hacia tu éxito digital.
          </p>
        </div>
      </div>

      <div class="w-[40%] aspect-square absolute top-0 right-0">
        <div class="w-[20%] aspect-square absolute top-0 left-0">
          <div class="w-full h-full bg-[#E9E8E8] [mask-image:radial-gradient(circle_at_bottom_left,transparent_70%,black_71%)]"></div>
        </div>

        <div class="w-full flex justify-end">
          <div class="w-[80%] aspect-square bg-[#E9E8E8] rounded-bl-[2rem] flex justify-center items-center">
            <div class="w-[70%] aspect-square rounded-full bg-[#FFAB50] flex justify-center items-center">
              <Image src={Arcadia_ico} alt="Arcadia_Logo" class="w-[50%]" loading="lazy"/>
            </div>
          </div>
        </div>

        <div class="w-[20%] aspect-square absolute bottom-0 right-0">
          <div class="w-full h-full bg-[#E9E8E8] [mask-image:radial-gradient(circle_at_bottom_left,transparent_70%,black_71%)]"></div>
        </div>
      </div>

      <div class="w-full absolute bottom-[25%] right-0 z-0 flex justify-end">
        <Image
          src={Arcadia_ico}
          alt="Logo de Arcadia"
          class="w-[85%] md:w-[55%] lg:w-[75%] xl:w-[85%] h-auto"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
      </div>
    </div>
    {/* EXTRAS */}
    <div class="w-full h-[20%] flex justify-around items-center leading-none IbmRegular
      text-[3vw] md:text-[2.2vw] lg:text-[1vw] xl:text-[1vw] Arcadia_background p-[2rem] rounded-xl
    ">
      <div class="w-full flex items-center justify-center gap-[1rem]">
        <div class="flex flex-col justify-start items-center">
          <div class="flex justify-start items-center gap-[1rem]">
            <div>
              <p class="IbmBold text-[8vw] md:text-[4.4vw] lg:text-[2vw] xl:text-[2vw]">1 AÑO</p>
              <p>De Hosting</p>
            </div>
            <p class="IbmBold text-[9vw] md:text-[5.4vw] lg:text-[3vw] xl:text-[3vw]">+</p>
          </div>
          <div>
            <p class="IbmBold text-[8vw] md:text-[4.4vw] lg:text-[2vw] xl:text-[2vw]">Dominio</p>
            <p>Totalmente gratis</p>
          </div>
        </div>
        <div class="w-[30%] aspect-1/1 bg-[#E9E8E8] flex flex-col items-center justify-center p-[1rem]
          IbmBold text-[2vw] md:text-[3vw] lg:text-[.6vw] xl:text-[.7vw] 2xl:text-[1vw]
        ">
          <p>Todo incluido</p>
          <p>en tu compra</p>
        </div>
      </div>
    </div>
  </div>
</div>
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  /* ===============================
     VALIDACIÓN + FEEDBACK VISUAL
  =============================== */
  const form = document.querySelector('form[action="/api/contact"]');
  const email = form?.querySelector('input[type="email"]');
  const button = form?.querySelector('button[type="submit"]');

  if (form && email && button) {
    form.addEventListener("submit", (e) => {
      if (!email.checkValidity()) {
        e.preventDefault();

        // foco al input
        email.focus();

        // ---- animación botón ----
        button.style.transition =
          "transform 150ms ease, border 150ms ease, box-shadow 150ms ease";

        button.style.border = "2px solid rgba(239,68,68,0.9)"; // rojo
        button.style.boxShadow = "0 0 0 4px rgba(239,68,68,0.25)";
        button.style.transform = "translateX(-4px)";

        // ida y vuelta
        setTimeout(() => {
          button.style.transform = "translateX(4px)";
        }, 120);

        setTimeout(() => {
          button.style.transform = "translateX(0)";
        }, 240);

        // limpiar estilos
        setTimeout(() => {
          button.style.border = "";
          button.style.boxShadow = "";
          button.style.transform = "";
        }, 380);
      }
    });
  }

  /* ===============================
     CARRUSEL (TU CÓDIGO)
  =============================== */
  const carousel = document.getElementById("carousel-2");
  const track = document.getElementById("carousel-track-2");

  if (!carousel || !track) return;

  const controls = track.parentElement.nextElementSibling;
  const prevBtn = controls.children[0];
  const nextBtn = controls.children[1];

  let isAnimating = false;
  const gap = 16;

  const getStep = () =>
    track.children[0].offsetWidth + gap;

  function next() {
    if (isAnimating) return;
    isAnimating = true;

    const step = getStep();
    track.style.transition = "transform 300ms ease";
    track.style.transform = `translateX(-${step}px)`;

    track.addEventListener("transitionend", () => {
      track.style.transition = "none";
      track.style.transform = "translateX(0)";
      track.appendChild(track.firstElementChild);
      isAnimating = false;
    }, { once: true });
  }

  function prev() {
    if (isAnimating) return;
    isAnimating = true;

    const step = getStep();
    track.style.transition = "none";
    track.insertBefore(track.lastElementChild, track.firstElementChild);
    track.style.transform = `translateX(-${step}px)`;
    track.offsetHeight;
    track.style.transition = "transform 300ms ease";
    track.style.transform = "translateX(0)";

    track.addEventListener("transitionend", () => {
      track.style.transition = "none";
      isAnimating = false;
    }, { once: true });
  }

  nextBtn.addEventListener("click", next);
  prevBtn.addEventListener("click", prev);
});
</script>
